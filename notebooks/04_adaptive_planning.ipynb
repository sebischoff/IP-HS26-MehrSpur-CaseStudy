    "                    'definition': 'Share of reporting-area modeled peak person-trips, including short trips.',\n",
    "                    'monitoring_indicator': True,\n",
    "                    'display_unit': '%',\n",
    "                    'scale': 100.0},\n",
    " 'car_share_trips': {'label': 'Car trip share',\n",
